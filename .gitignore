.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.pem
*.key
*.cert
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

